# Binaries
# anchored: the binary is built at the repo root, and a bare "mail-app-cli"
# would also ignore skill/mail-app-cli/ (gitignore matches any path segment).
/mail-app-cli
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Go workspace file
go.work

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
